<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>5a9ccb85-5481-458b-b146-7e96ed16d2bb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.CosmosDB" />
    <PackageReference Include="Aspire.Hosting.Azure.Functions" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" />
    <PackageReference Include="Aspire.Hosting.OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ancela.FunctionApp\Ancela.FunctionApp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- ASPIRE010 (new in 13.5) fires because AspireUseCliBundle defaults to false. Opting in
         would resolve DCP and the dashboard from the installed Aspire CLI rather than from NuGet,
         which trades a reproducible restore for a dependency on whichever aspire is on PATH.
         Keeping the NuGet-restored orchestration dependencies and silencing the advisory. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

</Project>
